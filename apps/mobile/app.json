{
  "expo": {
    "name": "Haveri Milk Union",
    "slug": "haveri-milk-union",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hmu",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#1448CC",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "coop.haverimunion.dealer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1448CC"
      },
      "package": "coop.haverimunion.dealer"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "265356ba-90f5-4f4d-b0ec-ccc2a2402a9d"
      }
    }
  }
}
