{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@hmu/db":                        ["../../packages/db/dist/index.d.ts"],
      "@hmu/db/*":                      ["../../packages/db/dist/*.d.ts"],
      "@hmu/db/schema":                 ["../../packages/db/dist/schema/index.d.ts"],
      "@hmu/db/reconciliation":         ["../../packages/db/dist/reconciliation/index.d.ts"],
      "@hmu/db/polling-replication":    ["../../packages/db/dist/polling-replication/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    // Not yet wired into index.ts (imports are commented out). The
    // bootstrap depends on getDbManager, which is still commented out
    // in @hmu/db's index.ts. Excluded so the worker build stays green;
    // re-include once the dual-DB export is enabled.
    "src/polling-replication-bootstrap.ts"
  ]
}
