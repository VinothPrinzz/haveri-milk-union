# ============================================================================
# Environment variables for the API + worker.
#
# Local dev:  copy this file to `.env` and fill in real values.
# Production: these are set as Fly secrets (`fly secrets import`), never
#             committed. NODE_ENV / API_HOST / API_PORT are set by fly.toml
#             in production, so you do NOT need them in the Fly secrets.
#
# NEVER put real credentials in this file — it is committed to git.
# ============================================================================

# ── Database (Supabase — Mumbai / ap-south-1) ────────────────────────────
# DATABASE_URL:        direct connection (port 5432) — used for migrations.  REQUIRED.
# DATABASE_URL_POOLED: transaction pooler (port 6543) — used at runtime.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Auth secrets — REQUIRED, min 32 chars each (API exits on boot without them) ──
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
SESSION_SECRET=change-this-to-yet-another-long-random-string

# ── Internal job auth — API and worker MUST share the exact same value ──
INTERNAL_JOB_SECRET=change-this-to-a-long-random-string

# ── Runtime config (set by fly.toml in production; defaults shown for local) ──
# NODE_ENV=development           # fly.toml sets this to "production"
# API_HOST=0.0.0.0               # default 0.0.0.0
# API_PORT=3001                  # default 3001
# WEB_ORIGIN: comma-separated CORS origins allowed in production.
#             Defaults to https://admin.havemul.in when unset.
# WEB_ORIGIN=https://admin.havemul.in

# ── Cloudflare R2 (file / PDF storage) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hmu-files
R2_PUBLIC_URL=

# ── Razorpay (payments — SERVER-SIDE secrets; never ship these in the app) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase (push notifications) ──
# FIREBASE_PRIVATE_KEY: keep the literal \n sequences, all on one line.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Worker → API callback (used by the payment-reconciliation job) ──
# Local: http://localhost:3001    Prod: https://api.havemul.in
API_URL=http://localhost:3001
