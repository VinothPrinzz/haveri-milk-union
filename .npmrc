# Use npm-style hoisting (real directories, no symlinks to the pnpm virtual store).
# This is required for EAS Build on Linux: pnpm's default symlink-based virtual
# store creates links whose targets embed the Windows absolute path
# (e.g. C:/App development/…/node_modules/.pnpm/…). The Linux Gradle build treats
# those Windows paths as relative, producing broken projectDirectory paths.
# With node-linker=hoisted, packages are real directories — no symlinks, no
# cross-platform path issues.
node-linker=hoisted

# Keep hoisting all packages to the root node_modules so Metro and Gradle
# autolinking can both find them without extra configuration.
shamefully-hoist=true
public-hoist-pattern[]=*
